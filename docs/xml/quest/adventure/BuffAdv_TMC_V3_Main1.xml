		   <questrunning item="BuffAdv_TMC_V3_Main1"/>
		</startcondition>
		  <triggers>
		  	<onmap max="0" item="tmc_buffad_stronghold_ruins_wildlife_north" locaExtension="DefeatTMCStrongholdRuinsNorth"/>		
