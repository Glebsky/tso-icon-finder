		   	<questcomplete item="BuffAdv_OneStepAhead_SpawnShip4"/>
		</startcondition>
		<triggers>
           <onmap item="TreasureShip" min="0"/>
		</triggers>
		<posteffects>
		</posteffects>	
	</quest>	
	
</Root>

    
    
      
      
      
      


