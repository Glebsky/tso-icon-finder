		<posteffects>
			<spawnbuilding name="TreasureShip" mode="enemy" action="ignoreBlocking,spawnInstant,replace" x="32" y="10" units="OrientalSailorMilitia|150,OrientalSailorCanoneer|125,TreasureShipLoot|40" />
		</posteffects>	
	</quest>
	<quest name="BuffAdv_OneStepAhead_SpawnShip4" showQuestWindow="false" showRewardWindow="false" >
		<startcondition>
		   <questactive item="BuffAdv_OneStepAhead_Main"/>
		</startcondition>
		<triggers>
           <buffappliedonadventure min="4" item="EffectBuffTreasureFleetReportHigh"/>
		</triggers>
		<posteffects>
			<spawnbuilding name="TreasureShip" mode="enemy" action="ignoreBlocking,spawnInstant,replace" x="30" y="14" units="OrientalSailorMilitia|150,OrientalSailorCanoneer|125,TreasureShipLoot|40" />
		</posteffects>	
	</quest>	
	
	<quest name="BuffAdv_OneStepAhead_ShipAchievement" showQuestWindow="false" showRewardWindow="false" notifyHomeZone="true">
