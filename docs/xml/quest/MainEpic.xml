    <!-- Epic Raids Main -->
    
      <quest name="MainEpic" type="Story" icon="QuestLong" npc="quest_character_fin02.png" helpName="Help_window_epic_raids_0" showRewardWindow="true">            
         <startcondition>
           <playerlevel min="42" />
         </startcondition>
         <preeffects>
         </preeffects>
         <helpeffects>
         </helpeffects>
         <triggers>
           <trigger type="QuestComplete" name="MainEpicSub1" condition="questcompleted" amount="1"/>
           <trigger type="QuestComplete" name="MainEpicSub2" condition="questcompleted" amount="1"/>
           <trigger type="QuestComplete" name="MainEpicSub3" condition="questcompleted" amount="1"/>
           <trigger type="QuestComplete" name="MainEpicSub4" condition="questcompleted" amount="1"/>
           <trigger type="QuestComplete" name="MainEpicSub5" condition="questcompleted" amount="1"/>
           <trigger type="QuestComplete" name="MainEpicSub6" condition="questcompleted" amount="1"/>
