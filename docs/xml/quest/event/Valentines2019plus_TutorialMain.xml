	<!-- Tutorial Quests -->
	<quest name="Valentines2019plus_TutorialMain" type="Event" icon="ValentinesFlower" cancelable="false" npc="quest_character_flora.png" showQuestWindow="True" showRewardWindow="true" linkEventWindow="true">
		<triggers>
			<questcomplete item="Valentines2019plus_TutorialReach16"/>
