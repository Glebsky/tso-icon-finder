	<quest name="Valentines2019plus_TutorialArchive" type="Event" connectedToQuest="Valentines2019plus_TutorialMain" icon="ValentinesFlower" cancelable="false" npc="quest_character_flora.png" showRewardWindow="true" linkEventWindow="true">
