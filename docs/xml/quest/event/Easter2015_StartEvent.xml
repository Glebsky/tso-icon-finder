	<!-- EASTER -->
	<!-- 2015 -->

	<quest name="Easter2015_StartEvent" showQuestWindow="false" showRewardWindow="false">
		<posteffects>
			<startquest name="Easter2015_EventRunning" />
			<startquest name="Easter2015_EventRunning_Shop" />
		</posteffects>
	</quest>

	<quest name="Easter2015_EventRunning" showQuestWindow="false" showRewardWindow="false">
		<triggers>
			<trigger type="QuestComplete" name="Easter2015_StopEvent_Running" condition="questcompleted" amount="1" />
		</triggers>
	</quest>

	<!-- Trigger to enable event shop -->
	<quest name="Easter2015_EventRunning_Shop" showQuestWindow="false" showRewardWindow="false">
		<triggers>
			<trigger type="QuestComplete" name="Easter2015_StopEvent_Shop" condition="questcompleted" amount="1" />
		</triggers>
	</quest>

	<quest name="Easter2015_StopEvent_Running" showQuestWindow="false" showRewardWindow="false" >
			<posteffects>
			<cancelquest type="startsWith" name="Easter2015_TutAchievement" />
			<cancelquest type="startsWith" name="Easter2015_Main" />
		</posteffects>
	</quest>

	<!-- Trigger for removing event shop -->
	<quest name="Easter2015_StopEvent_Shop" showQuestWindow="false" showRewardWindow="false" />

